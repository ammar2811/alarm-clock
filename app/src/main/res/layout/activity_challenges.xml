<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Only shown while a photo challenge is configured without camera access, since that
         is the one case where a configured challenge silently will not run. -->
    <LinearLayout
        android:id="@+id/challenges_permission_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white_08p"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/challenge_camera_needed"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/challenges_grant_camera"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/challenge_grant_camera"
            android:textColor="?attr/colorAccent" />

    </LinearLayout>

    <TextView
        android:id="@+id/challenges_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:padding="32dp"
        android:text="@string/challenge_empty_hint"
        android:textColor="@color/white_63p"
        android:textSize="16sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/challenges_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp"
        android:paddingTop="8dp" />

    <Button
        android:id="@+id/challenges_add"
        style="@style/Widget.AppCompat.Button.Borderless"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:text="@string/challenge_add"
        android:textColor="?attr/colorAccent" />

</LinearLayout>
