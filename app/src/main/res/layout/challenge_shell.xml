<!-- Common chrome for every challenge: the clock and progress at the top, the challenge's
     own content filling the rest. The background is transparent so the ring screen's window
     colour shows through and the challenge reads as part of the same screen. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="24dp"
    android:paddingBottom="16dp">

    <TextClock
        android:id="@+id/challenge_clock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:includeFontPadding="false"
        android:singleLine="true"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="32sp" />

    <TextView
        android:id="@+id/challenge_progress"
        style="@style/body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone" />

    <TextView
        android:id="@+id/challenge_prompt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:textColor="?attr/colorOnSurface"
        android:textSize="20sp" />

    <!-- Reserved height so appearing and clearing the message does not shift the layout. -->
    <TextView
        android:id="@+id/challenge_message"
        style="@style/body"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textColor="?attr/colorPrimary" />

    <FrameLayout
        android:id="@+id/challenge_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1" />

</LinearLayout>
