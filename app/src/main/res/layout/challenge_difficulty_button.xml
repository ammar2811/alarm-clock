<!-- One difficulty option. Selected state is driven in code so the row behaves like a
     segmented control without pulling in another widget. -->
<TextView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:background="@drawable/challenge_difficulty_background"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center"
    android:paddingBottom="10dp"
    android:paddingTop="10dp"
    android:textColor="@color/challenge_difficulty_text"
    android:textSize="13sp" />
