<!-- The math challenge carries its own digit pad rather than using the soft keyboard: a
     keyboard is unreliable above the lock screen, and answers are always non-negative
     integers so digits, delete and submit are the whole input surface. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Spacers above and below centre the problem in the space left over by the keypad,
         rather than stranding it at the top with a gap underneath. -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/math_expression"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:singleLine="true"
        android:textColor="@color/white"
        android:textSize="44sp" />

    <TextView
        android:id="@+id/math_answer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:hint="@string/challenge_math_answer_hint"
        android:singleLine="true"
        android:textColor="?attr/colorAccent"
        android:textColorHint="@color/white_63p"
        android:textSize="36sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <androidx.gridlayout.widget.GridLayout
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/math_keypad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:columnCount="3"
        app:rowCount="4" />

</LinearLayout>
