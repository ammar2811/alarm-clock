<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical">

    <!-- Monospaced so lookalike characters stay distinguishable while copying them. -->
    <TextView
        android:id="@+id/retype_target"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:gravity="center"
        android:letterSpacing="0.15"
        android:textColor="?attr/colorOnSurface"
        android:textIsSelectable="false"
        android:textSize="32sp" />

    <EditText
        android:id="@+id/retype_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:fontFamily="monospace"
        android:gravity="center"
        android:hint="@string/challenge_retype_hint"
        android:importantForAutofill="no"
        android:imeOptions="actionDone"
        android:inputType="textVisiblePassword"
        android:letterSpacing="0.15"
        android:maxLines="1"
        android:textColor="?attr/colorOnSurface"
        android:textColorHint="?attr/colorOnSurfaceVariant"
        android:textSize="28sp" />

    <Button
        android:id="@+id/retype_submit"
        style="@style/Widget.AppCompat.Button.Borderless"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:text="@string/challenge_check"
        android:textColor="?attr/colorPrimary" />

</LinearLayout>
