<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.DeskClock" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowContentOverlay">@null</item>

        <!-- BaseActivity lays content out behind the system bars, so the bars themselves
             must not paint. Material 3 leaves statusBarColor to its MaterialComponents
             ancestor, which derives it from the primary colour and draws an opaque band
             over the layout. The light flags then decide which way the icons point against
             whatever surface ends up behind them. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">?attr/isLightTheme</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">?attr/isLightTheme</item>

        <!-- The appcompat widgets that still read colorAccent. Material 3 inherits it as an
             alias for colorSecondary, which is the desaturated palette, so pin it back to
             the accent the app actually means. -->
        <item name="colorAccent">?attr/colorPrimary</item>
        <item name="colorControlActivated">?attr/colorPrimary</item>
        <item name="colorControlNormal">?attr/colorOnSurfaceVariant</item>
        <item name="imageButtonStyle">@style/Widget.ImageButton</item>

        <!-- The fallback palette for API 24-30, defined per mode in colors_theme.xml. -->
        <item name="colorPrimary">@color/theme_primary</item>
        <item name="colorOnPrimary">@color/theme_on_primary</item>
        <item name="colorPrimaryContainer">@color/theme_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/theme_on_primary_container</item>
        <item name="colorSecondaryContainer">@color/theme_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/theme_on_secondary_container</item>
        <item name="colorSurface">@color/theme_surface</item>
        <item name="android:colorBackground">@color/theme_background</item>
        <item name="colorOnSurface">@color/theme_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/theme_on_surface_variant</item>
        <item name="colorSurfaceContainerHigh">@color/theme_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/theme_surface_container_highest</item>
        <item name="colorOutline">@color/theme_outline</item>
        <item name="colorOutlineVariant">@color/theme_outline_variant</item>
        <item name="colorSecondary">@color/theme_secondary</item>
        <item name="colorOnSecondary">@color/theme_on_secondary</item>
        <item name="colorTertiary">@color/theme_tertiary</item>
        <item name="colorOnTertiary">@color/theme_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/theme_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/theme_on_tertiary_container</item>
        <item name="colorSurfaceVariant">@color/theme_surface_variant</item>
    </style>

    <!-- The alarm picker shown when a voice command matches more than one alarm. A dialog
         needs a different Material 3 parent from the app theme, so it cannot inherit from
         Theme.DeskClock and has to name the palette again. The values themselves are not
         repeated: both lists point at the same colours in colors_theme.xml. -->
    <style name="Theme.DeskClock.Dialog" parent="Theme.Material3.DayNight.Dialog">
        <!-- The layout draws its own heading, so the window title would be a second copy of
             the same words. -->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>

        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:windowMinWidthMinor">90%</item>
        <item name="android:windowMinWidthMajor">70%</item>

        <item name="colorAccent">?attr/colorPrimary</item>
        <item name="colorControlActivated">?attr/colorPrimary</item>
        <item name="colorControlNormal">?attr/colorOnSurfaceVariant</item>

        <item name="colorPrimary">@color/theme_primary</item>
        <item name="colorOnPrimary">@color/theme_on_primary</item>
        <item name="colorPrimaryContainer">@color/theme_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/theme_on_primary_container</item>
        <item name="colorSecondaryContainer">@color/theme_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/theme_on_secondary_container</item>
        <item name="colorSurface">@color/theme_surface</item>
        <item name="android:colorBackground">@color/theme_background</item>
        <item name="colorOnSurface">@color/theme_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/theme_on_surface_variant</item>
        <item name="colorSurfaceContainerHigh">@color/theme_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/theme_surface_container_highest</item>
        <item name="colorOutline">@color/theme_outline</item>
        <item name="colorOutlineVariant">@color/theme_outline_variant</item>
        <item name="colorSecondary">@color/theme_secondary</item>
        <item name="colorOnSecondary">@color/theme_on_secondary</item>
        <item name="colorTertiary">@color/theme_tertiary</item>
        <item name="colorOnTertiary">@color/theme_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/theme_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/theme_on_tertiary_container</item>
        <item name="colorSurfaceVariant">@color/theme_surface_variant</item>
    </style>

    <style name="Theme.DeskClock.Settings">
        <!-- Attributes from androidx.appcompat.appcompat -->
        <item name="actionBarStyle">@style/Widget.ActionBar</item>
        <item name="windowActionBar">true</item>
        <item name="windowNoTitle">false</item>

        <!-- Attributes from androidx.preference.-->
        <item name="preferenceTheme">@style/PreferenceThemeOverlay</item>
    </style>

    <style name="Theme.DeskClock.RingtonePicker">
        <!-- Attributes from androidx.appcompat.appcompat -->
        <item name="actionBarStyle">@style/Widget.ActionBar</item>
        <item name="windowActionBar">true</item>
        <item name="windowNoTitle">false</item>
    </style>

    <style name="Theme.DeskClock.CitySelection">
        <!-- Attributes from androidx.appcompat.appcompat -->
        <item name="actionBarStyle">@style/Widget.ActionBar.NoTitle</item>
        <item name="windowActionBar">true</item>
        <item name="windowNoTitle">false</item>
    </style>

    <!-- The screensaver is a dock-at-night display and stays dark whatever the app's theme
         setting is, because a white screen at 3am is not a feature. A DreamService has no
         AppCompatDelegate, so it cannot follow setDefaultNightMode anyway; naming the dark
         theme here is both the correct behaviour and the only one available. -->
    <style name="Theme.DeskClock.Screensaver" parent="Theme.Material3.DynamicColors.Dark.NoActionBar">
        <item name="android:windowContentOverlay">@null</item>
        <item name="colorAccent">?attr/colorPrimary</item>
    </style>

</resources>
