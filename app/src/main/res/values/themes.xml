<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.DeskClock" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowContentOverlay">@null</item>

        <!-- BaseActivity lays content out behind the system bars, so the bars themselves
             must not paint. Material 3 leaves statusBarColor to its MaterialComponents
             ancestor, which derives it from the primary colour and draws an opaque band
             over the layout. The light flags then decide which way the icons point against
             whatever surface ends up behind them. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">?attr/isLightTheme</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">?attr/isLightTheme</item>

        <!-- The appcompat widgets that still read colorAccent. Material 3 inherits it as an
             alias for colorSecondary, which is the desaturated palette, so pin it back to
             the accent the app actually means. -->
        <item name="colorAccent">?attr/colorPrimary</item>
        <item name="colorControlActivated">?attr/colorPrimary</item>
        <item name="colorControlNormal">?attr/colorOnSurfaceVariant</item>
        <item name="imageButtonStyle">@style/Widget.ImageButton</item>

        <!-- Fallback palette, seeded from the indigo this app shipped for years. On API 31
             and up DynamicColors applies the wallpaper palette over the top with
             Theme.applyStyle(force = true), so every one of these loses cleanly and the
             device's own colours win. Below 31 there is no wallpaper palette to read, and
             without these the app would fall back to Material's baseline purple. -->
        <item name="colorPrimary">#555B96</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#E0E0FF</item>
        <item name="colorOnPrimaryContainer">#10174B</item>
        <item name="colorSecondaryContainer">#E1E0F9</item>
        <item name="colorOnSecondaryContainer">#181A2C</item>
        <item name="colorSurface">#FFFBFF</item>
        <item name="android:colorBackground">#FFFBFF</item>
        <item name="colorOnSurface">#1B1B1F</item>
        <item name="colorOnSurfaceVariant">#46464F</item>
        <item name="colorSurfaceContainerHigh">#E9E7EF</item>
        <item name="colorSurfaceContainerHighest">#E4E1E9</item>
        <item name="colorOutline">#777680</item>
        <item name="colorOutlineVariant">#C7C5D0</item>
    </style>

    <style name="Theme.DeskClock.Settings">
        <!-- Attributes from androidx.appcompat.appcompat -->
        <item name="actionBarStyle">@style/Widget.ActionBar</item>
        <item name="windowActionBar">true</item>
        <item name="windowNoTitle">false</item>

        <!-- Attributes from androidx.preference.-->
        <item name="preferenceTheme">@style/PreferenceThemeOverlay</item>
    </style>

    <style name="Theme.DeskClock.RingtonePicker">
        <!-- Attributes from androidx.appcompat.appcompat -->
        <item name="actionBarStyle">@style/Widget.ActionBar</item>
        <item name="windowActionBar">true</item>
        <item name="windowNoTitle">false</item>
    </style>

    <style name="Theme.DeskClock.CitySelection">
        <!-- Attributes from androidx.appcompat.appcompat -->
        <item name="actionBarStyle">@style/Widget.ActionBar.NoTitle</item>
        <item name="windowActionBar">true</item>
        <item name="windowNoTitle">false</item>
    </style>

    <!-- The screensaver is a dock-at-night display and stays dark whatever the app's theme
         setting is, because a white screen at 3am is not a feature. A DreamService has no
         AppCompatDelegate, so it cannot follow setDefaultNightMode anyway; naming the dark
         theme here is both the correct behaviour and the only one available. -->
    <style name="Theme.DeskClock.Screensaver" parent="Theme.Material3.DynamicColors.Dark.NoActionBar">
        <item name="android:windowContentOverlay">@null</item>
        <item name="colorAccent">?attr/colorPrimary</item>
    </style>

</resources>
