<!-- The window background for an activity styled as a dialog. Material 3 shapes its own
     AlertDialogs from code, which an activity window never goes through, so the surface and
     the 28dp corner have to be stated here. Both sides follow the theme, so this one file
     covers light and dark. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/colorSurfaceContainerHigh" />
    <corners android:radius="28dp" />
</shape>
