<resources>

    <!-- From API 31 the system publishes the wallpaper palette as ordinary resources, so the
         notification accent can follow it without the app deriving anything itself. The 600
         weight is mid-tone on purpose: it has to carry on both the light and the dark shade,
         because SystemUI picks which one is showing, not us. -->
    <color name="notification_accent">@android:color/system_accent1_600</color>

</resources>
