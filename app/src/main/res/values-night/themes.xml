<resources>

    <!-- The night colour roles live in values-night/colors_theme.xml; the app theme
         itself is declared once, in values/themes.xml. What is left here is the action
         bar, whose Material 3 style genuinely differs between the two modes. -->

    <style name="Widget.ActionBar" parent="Widget.Material3.ActionBar.Solid">
        <item name="displayOptions">showTitle|homeAsUp</item>
    </style>

    <style name="Widget.ActionBar.NoTitle">
        <item name="displayOptions">homeAsUp</item>
    </style>

</resources>
