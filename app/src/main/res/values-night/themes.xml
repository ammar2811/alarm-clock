<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- The night half of the fallback palette in values/themes.xml, from the same indigo
         seed. Only the colour roles differ; everything else is inherited. -->
    <style name="Theme.DeskClock" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowContentOverlay">@null</item>

        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">?attr/isLightTheme</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">?attr/isLightTheme</item>

        <item name="colorAccent">?attr/colorPrimary</item>
        <item name="colorControlActivated">?attr/colorPrimary</item>
        <item name="colorControlNormal">?attr/colorOnSurfaceVariant</item>
        <item name="imageButtonStyle">@style/Widget.ImageButton</item>

        <item name="colorPrimary">#C0C4FF</item>
        <item name="colorOnPrimary">#262D63</item>
        <item name="colorPrimaryContainer">#3D437C</item>
        <item name="colorOnPrimaryContainer">#E0E0FF</item>
        <item name="colorSecondaryContainer">#434659</item>
        <item name="colorOnSecondaryContainer">#E1E0F9</item>
        <item name="colorSurface">#131318</item>
        <item name="android:colorBackground">#131318</item>
        <item name="colorOnSurface">#E4E1E9</item>
        <item name="colorOnSurfaceVariant">#C7C5D0</item>
        <item name="colorSurfaceContainerHigh">#292930</item>
        <item name="colorSurfaceContainerHighest">#34343B</item>
        <item name="colorOutline">#918F9A</item>
        <item name="colorOutlineVariant">#46464F</item>
    </style>

    <style name="Widget.ActionBar" parent="Widget.Material3.ActionBar.Solid">
        <item name="displayOptions">showTitle|homeAsUp</item>
    </style>

    <style name="Widget.ActionBar.NoTitle">
        <item name="displayOptions">homeAsUp</item>
    </style>

</resources>
